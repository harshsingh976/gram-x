# =====================================================================
# GRAM-X PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# ----------------- 1. System & App Core -----------------
APP_MODE=production
LOG_LEVEL=INFO
GRAMX_BASE_DOMAIN=gramx.gov.in
FRONTEND_URL=https://gramx-frontend.onrender.com

# ----------------- 2. Managed PostgreSQL Database -----------------
# Production managed PostgreSQL connection URI (e.g. Render, AWS RDS, Supabase)
DATABASE_URL=postgresql://gramx_user:your_secure_password@postgres.render.com:5432/gramx_db
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ----------------- 3. Authentication & JWT Tokens -----------------
SECRET_KEY=generate_a_64_char_cryptographic_secret_here
REFRESH_SECRET_KEY=generate_another_64_char_cryptographic_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=15

# ----------------- 4. Cloud Object Storage (S3 / R2 / MinIO) -----------------
# Set STORAGE_BACKEND=s3 for AWS S3 / Cloudflare R2 / MinIO in production
STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=gramx-evidence-production
OBJECT_STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
OBJECT_STORAGE_ACCESS_KEY=your_aws_or_r2_access_key
OBJECT_STORAGE_SECRET_KEY=your_aws_or_r2_secret_key
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_SECURE=true

# ----------------- 5. Real Speech-To-Text (STT) Service -----------------
# Providers: whisper_api, google_cloud, faster_whisper, offline_fallback
STT_PROVIDER=whisper_api
STT_API_KEY=your_openai_or_groq_api_key
STT_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1

# ----------------- 6. Transactional Email Service -----------------
# Providers: smtp, sendgrid, console
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=governance@gramx.gov.in
SMTP_PASSWORD=your_app_password_or_smtp_secret
SMTP_USE_TLS=true
EMAIL_FROM=noreply@gramx.gov.in
SENDGRID_API_KEY=your_sendgrid_api_key_if_using_sendgrid

# ----------------- 7. MongoDB Document Store -----------------
MONGODB_URI=mongodb://localhost:27017/gramx
MONGODB_DB_NAME=gramx

# ----------------- 8. Vector Database & Semantic Embeddings -----------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DATABASE_URL=postgresql://gramx_user:your_password@postgres:5432/gramx_db
