# 1. Supabase Platform (Authentication & PostgreSQL)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# 2. Cloudflare R2 Public CDN Distribution
