# ================================================================
# GRAM-X — Environment Configuration Template
# Copy to .env for local development or set in Render Secrets Dashboard
# ================================================================

# Environment Mode: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# 1. SQL System of Record (PostgreSQL in Production / SQLite in Development)
# For Render: Set automatically from Render PostgreSQL database connection
DATABASE_URL=postgresql://gramx_user:your_password_here@dpg-xxxx.render.com/gramx_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# 2. Authentication & Cryptographic Signing
SECRET_KEY=generate_a_strong_random_secret_for_jwt_token_signing_here
REFRESH_SECRET_KEY=generate_a_strong_random_secret_for_refresh_tokens_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=15

# 3. Cloud Object Storage (S3 / Cloudflare R2 / MinIO)
# Set to 's3' for production, 'local' for local offline development
STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=gramx-evidence
OBJECT_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY=your_storage_access_key_here
OBJECT_STORAGE_SECRET_KEY=your_storage_secret_key_here
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_SECURE=true

# 4. Speech-to-Text (STT) Provider Configuration
# Supported: whisper_api | google_cloud | faster_whisper | offline_fallback
STT_PROVIDER=whisper_api
STT_API_KEY=your_whisper_or_cloud_stt_api_key_here
STT_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1

# 5. Generative AI / Llama Triage Engine Configuration
LLAMA_PROVIDER=openai_compatible
LLAMA_API_KEY=your_llama_or_openai_api_key_here
LLAMA_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
LLAMA_MODEL=llama3-70b-8192

# 6. Transactional Email (Password Reset OTP / Governance Directives)
# Supported: smtp | sendgrid | console
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@gramx.gov.in
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_USE_TLS=true
EMAIL_FROM=noreply@gramx.gov.in
SENDGRID_API_KEY=your_sendgrid_api_key_if_using_sendgrid

# 7. Vector & Semantic Search Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DATABASE_URL=

# 8. Frontend & CORS Settings
CORS_ORIGINS=https://gramx-frontend.onrender.com,https://gramx.gov.in
VITE_API_BASE_URL=https://gramx-backend.onrender.com/api
