# ================================================================
# GRAM-X — PHASE 1 TARGET ARCHITECTURE CONFIGURATION
# Platform: React (Vercel) + Supabase (Auth/PostgreSQL/RLS) + Cloudflare R2 + Resend
# ================================================================

# 1. Supabase Frontend Public Credentials (Vercel Environment)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Supabase Server-Side Secret Key (Edge Functions / Backend Admin ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# 3. Cloudflare R2 Object Storage (Evidence Images / Media)
# Access keys are held only by serverless Edge Functions / Cloudflare Workers
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://assets.gramx.gov.in
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=gramx-evidence

# 4. Resend Transactional Email Provider (Invoked via Supabase Edge Function)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@gramx.gov.in

# 5. Cloudflare Security & CDN
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-public-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key
