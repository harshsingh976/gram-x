.overlay-root {
    width: 100%;
    height: 100%;
    position: absolute;
    padding: 20px;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
}

.header-container {
    background-color: rgba(15, 23, 42, 0.85);
    border-radius: 12px;
    padding: 14px 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    align-self: flex-start;
    pointer-events: auto;
}

.title-label {
    color: #38bdf8;
    font-size: 18px;
    -unity-font-style: bold;
}

.subtitle-label {
    color: #94a3b8;
    font-size: 12px;
}

.kpi-glass-panel {
    position: absolute;
    left: 20px;
    top: 100px;
    width: 280px;
    background-color: rgba(15, 23, 42, 0.88);
    border-radius: 12px;
    padding: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    pointer-events: auto;
}

.sim-glass-panel {
    position: absolute;
    right: 20px;
    top: 100px;
    width: 320px;
    background-color: rgba(15, 23, 42, 0.88);
    border-radius: 12px;
    padding: 18px;
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.3);
    pointer-events: auto;
}

.section-title {
    color: #e2e8f0;
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.kpi-card {
    background-color: rgba(30, 41, 59, 0.7);
    border-radius: 8px;
    padding: 10px;
    margin-bottom: 8px;
}

.kpi-name {
    color: #cbd5e1;
    font-size: 11px;
}

.kpi-val {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.kpi-val-green { color: #4ade80; }
.kpi-val-amber { color: #fbbf24; }

.primary-btn {
    background-color: #0284c7;
    color: #ffffff;
    border-radius: 8px;
    padding: 10px;
    margin-top: 14px;
    -unity-font-style: bold;
}

.primary-btn:hover {
    background-color: #0369a1;
}

.status-indicator {
    color: #94a3b8;
    font-size: 11px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}
